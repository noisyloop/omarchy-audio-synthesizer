[Unit]
Description=Soundgineer synth engine
Requires=soundgineer.socket
After=soundgineer.socket pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/bin/soundgineer-engine
Restart=on-failure
RestartSec=2
# No network, ever: only Unix sockets (control socket, PipeWire, JACK).
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=no

[Install]
Also=soundgineer.socket
